rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProvider(providerId) {
      return signedIn() && request.auth.uid == providerId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function verifiedProvider(providerId) {
      return exists(/databases/$(database)/documents/providers/$(providerId))
        && get(/databases/$(database)/documents/providers/$(providerId)).data.verified == true;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow get, list: if resource.data.verified == true || ownsProvider(providerId) || isAdmin();

      // Provider rating aggregates remain writable only by the trusted server process.
      allow create: if ownsProvider(providerId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.averageRating == 0
        && request.resource.data.totalReviews == 0;

      allow update: if ownsProvider(providerId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.verified == resource.data.verified
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['averageRating', 'totalReviews']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['verified', 'verificationUpdatedAt', 'verificationUpdatedBy'])
        && request.resource.data.verified is bool
        && request.resource.data.verificationUpdatedAt == request.time
        && request.resource.data.verificationUpdatedBy == request.auth.uid;
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if verifiedProvider(providerId);

        // The review document ID is the booking ID, so a customer can review
        // each completed booking once, including repeat work with one provider.
        allow create: if verifiedProvider(providerId)
          && signedIn()
          && request.resource.data.keys().hasAll([
            'bookingId', 'uid', 'displayName', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'bookingId', 'uid', 'displayName', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.bookingId == reviewId
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid != providerId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 2000
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/bookings/$(reviewId))
          && get(/databases/$(database)/documents/bookings/$(reviewId)).data.customerUid == request.auth.uid
          && get(/databases/$(database)/documents/bookings/$(reviewId)).data.providerId == providerId
          && get(/databases/$(database)/documents/bookings/$(reviewId)).data.status == 'completed';
        allow update, delete: if false;
      }
    }

    match /quoteRequests/{quoteId} {
      allow get, list: if signedIn()
        && (resource.data.customerUid == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin());

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'customerUid', 'customerName', 'customerEmail', 'providerId', 'providerName',
          'service', 'description', 'preferredDate', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerName', 'customerEmail', 'providerId', 'providerName',
          'service', 'description', 'preferredDate', 'status', 'createdAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.providerId is string
        && verifiedProvider(request.resource.data.providerId)
        && request.resource.data.providerName is string
        && request.resource.data.providerName.size() <= 120
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() > 0
        && request.resource.data['service'].size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.preferredDate is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'quoteAmount', 'providerResponse', 'respondedAt'])
        && request.resource.data.status == 'responded'
        && request.resource.data.quoteAmount is number
        && request.resource.data.quoteAmount > 0
        && request.resource.data.providerResponse is string
        && request.resource.data.providerResponse.size() > 0
        && request.resource.data.providerResponse.size() <= 1000
        && request.resource.data.respondedAt == request.time;

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == 'revision_requested'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'quoteAmount', 'providerResponse', 'respondedAt'])
        && request.resource.data.status == 'responded'
        && request.resource.data.quoteAmount is number
        && request.resource.data.quoteAmount > 0
        && request.resource.data.providerResponse is string
        && request.resource.data.providerResponse.size() > 0
        && request.resource.data.providerResponse.size() <= 1000
        && request.resource.data.respondedAt == request.time;

      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'responded'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'customerMessage', 'customerMessageAt'])
        && request.resource.data.status == 'revision_requested'
        && request.resource.data.customerMessage is string
        && request.resource.data.customerMessage.size() > 0
        && request.resource.data.customerMessage.size() <= 1000
        && request.resource.data.customerMessageAt == request.time;

      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'responded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(quoteId))
        && getAfter(/databases/$(database)/documents/bookings/$(quoteId)).data.quoteRequestId == quoteId
        && getAfter(/databases/$(database)/documents/bookings/$(quoteId)).data.customerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'responded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedAt'])
        && request.resource.data.status == 'declined'
        && request.resource.data.declinedAt == request.time;

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow get, list: if signedIn()
        && (resource.data.customerUid == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin());

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'quoteRequestId', 'customerUid', 'customerName', 'providerId', 'providerName',
          'service', 'description', 'preferredDate', 'quoteAmount', 'providerResponse',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'quoteRequestId', 'customerUid', 'customerName', 'providerId', 'providerName',
          'service', 'description', 'preferredDate', 'quoteAmount', 'providerResponse',
          'status', 'createdAt'
        ])
        && request.resource.data.quoteRequestId == bookingId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/quoteRequests/$(bookingId))
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.customerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.providerId == request.resource.data.providerId
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.customerName == request.resource.data.customerName
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.providerName == request.resource.data.providerName
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data['service'] == request.resource.data['service']
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.description == request.resource.data.description
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.preferredDate == request.resource.data.preferredDate
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.quoteAmount == request.resource.data.quoteAmount
        && getAfter(/databases/$(database)/documents/quoteRequests/$(bookingId)).data.providerResponse == request.resource.data.providerResponse;

      // Providers advance confirmed -> in_progress -> completed. Either party
      // may cancel only while the booking is confirmed.
      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && ((resource.data.status == 'confirmed' && request.resource.data.status == 'in_progress')
          || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
        && request.resource.data.statusUpdatedAt == request.time;

      allow update: if signedIn()
        && (resource.data.customerUid == request.auth.uid || resource.data.providerId == request.auth.uid)
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusUpdatedAt', 'cancelledBy'])
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid;

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'recipientUid', 'actorUid', 'type', 'title', 'message', 'read', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'recipientUid', 'actorUid', 'type', 'title', 'message', 'read', 'createdAt',
          'quoteRequestId', 'bookingId', 'bookingStatus'
        ])
        && request.resource.data.recipientUid is string
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.type == 'quote_request_received'
            && request.resource.data.quoteRequestId is string
            && !exists(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && existsAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.providerId == request.resource.data.recipientUid
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'pending')
          || (request.resource.data.type == 'customer_revision_requested'
            && request.resource.data.quoteRequestId is string
            && exists(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && existsAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && get(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'responded'
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'revision_requested'
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.providerId == request.resource.data.recipientUid)
          || (request.resource.data.type == 'quote_accepted'
            && request.resource.data.quoteRequestId is string
            && exists(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && existsAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && get(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'responded'
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.providerId == request.resource.data.recipientUid
            && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.quoteRequestId)))
          || (request.resource.data.type == 'quote_declined'
            && request.resource.data.quoteRequestId is string
            && exists(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && existsAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId))
            && get(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'responded'
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.status == 'declined'
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/quoteRequests/$(request.resource.data.quoteRequestId)).data.providerId == request.resource.data.recipientUid)
          || (request.resource.data.type == 'booking_status_updated'
            && request.resource.data.bookingId is string
            && request.resource.data.bookingStatus in ['in_progress', 'completed']
            && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
            && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.resource.data.recipientUid
            && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == request.resource.data.bookingStatus
            && ((request.resource.data.bookingStatus == 'in_progress'
                && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'confirmed')
              || (request.resource.data.bookingStatus == 'completed'
                && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'in_progress')))
          || (request.resource.data.type == 'booking_cancelled'
            && request.resource.data.bookingId is string
            && request.resource.data.bookingStatus == 'cancelled'
            && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
            && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'confirmed'
            && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'cancelled'
            && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.cancelledBy == request.auth.uid
            && ((get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.auth.uid
                && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.resource.data.recipientUid)
              || (get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid
                && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.resource.data.recipientUid)))
        );

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }
  }
}
